package com.ecartpay.sample

/**
 * SDK Credentials for the Sample Application.
 *
 * IMPORTANT: Copy this file to BuildCredentials.kt and replace with your own credentials.
 *
 * To obtain your credentials:
 * 1. Log in to https://ecartpay.com
 * 2. Navigate to Integrations > Dev Tools > Credentials
 * 3. Create new API Keys selecting type "SDK Tap To Phone"
 * 4. Copy your Public ID and Private ID below
 *
 * WARNING: Never commit BuildCredentials.kt to version control!
 */
object BuildCredentials {
    const val PUBLIC_ID = "pk_sandbox_your_public_id_here"
    const val PRIVATE_ID = "sk_sandbox_your_private_id_here"
}
